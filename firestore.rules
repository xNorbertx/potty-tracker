rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null &&
        !exists(/databases/$(database)/documents/deletion_blocks/$(request.auth.uid));
    }

    function babyBefore(babyId) {
      return get(/databases/$(database)/documents/babies/$(babyId));
    }

    function babyAfter(babyId) {
      return getAfter(/databases/$(database)/documents/babies/$(babyId));
    }

    function isBabyMember(babyId) {
      return isSignedIn() &&
        request.auth.uid in babyBefore(babyId).data.memberUids;
    }

    function isValidBabyCreate() {
      return request.resource.data.keys().hasOnly([
          'name', 'ownerUid', 'memberUids', 'memberLabels', 'memberEmails', 'shareCode', 'createdAt'
        ]) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.memberUids.size() == 1 &&
        request.resource.data.memberUids[0] == request.auth.uid &&
        request.resource.data.memberLabels.keys().hasOnly([request.auth.uid]) &&
        request.resource.data.memberEmails.keys().hasOnly([request.auth.uid]) &&
        request.resource.data.shareCode is string &&
        request.resource.data.shareCode.size() == 6;
    }

    function isRoutineBabyUpdate(babyId) {
      return isSignedIn() && request.auth.uid in resource.data.memberUids &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'memberLabels', 'memberEmails'
        ]) &&
        request.resource.data.memberUids == resource.data.memberUids &&
        request.resource.data.memberLabels.diff(resource.data.memberLabels)
          .affectedKeys().hasOnly([request.auth.uid]) &&
        (
          (!resource.data.keys().hasAny(['memberEmails']) &&
            request.resource.data.memberEmails.keys().hasOnly([request.auth.uid])) ||
          (resource.data.keys().hasAny(['memberEmails']) &&
            request.resource.data.memberEmails.diff(resource.data.memberEmails)
              .affectedKeys().hasOnly([request.auth.uid])
          )
        );
    }

    function isLeavingBaby(babyId) {
      return isSignedIn() && request.auth.uid in resource.data.memberUids &&
        resource.data.memberUids.size() > 1 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberUids', 'memberLabels', 'memberEmails'
        ]) &&
        request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1 &&
        request.resource.data.memberUids.hasOnly(resource.data.memberUids) &&
        !request.resource.data.memberUids.hasAny([request.auth.uid]) &&
        request.resource.data.memberLabels.diff(resource.data.memberLabels)
          .affectedKeys().hasOnly([request.auth.uid]) &&
        (
          !request.resource.data.keys().hasAny(['memberEmails']) ||
          (resource.data.keys().hasAny(['memberEmails']) &&
            request.resource.data.memberEmails.diff(resource.data.memberEmails)
              .affectedKeys().hasOnly([request.auth.uid])
          )
        );
    }

    function isJoiningBaby(babyId) {
      let before = babyBefore(babyId).data;
      let after = babyAfter(babyId).data;
      return isSignedIn() && !(request.auth.uid in before.memberUids) &&
        isVerifiedInvitation(before.shareCode, babyId, before.memberUids) &&
        after.diff(before).affectedKeys().hasOnly([
          'memberUids', 'memberLabels', 'memberEmails', 'shareCode'
        ]) &&
        after.memberUids.size() == before.memberUids.size() + 1 &&
        after.memberUids.hasAll(before.memberUids) &&
        after.memberUids.hasAny([request.auth.uid]) &&
        after.memberLabels.diff(before.memberLabels)
          .affectedKeys().hasOnly([request.auth.uid]) &&
        (
          (!before.keys().hasAny(['memberEmails']) &&
            after.memberEmails.keys().hasOnly([request.auth.uid])) ||
          (before.keys().hasAny(['memberEmails']) &&
            after.memberEmails.diff(before.memberEmails)
              .affectedKeys().hasOnly([request.auth.uid])
          )
        ) &&
        after.shareCode is string &&
        after.shareCode.size() == 6 &&
        after.shareCode != before.shareCode &&
        !existsAfter(/databases/$(database)/documents/share_codes/$(before.shareCode)) &&
        existsAfter(/databases/$(database)/documents/share_codes/$(after.shareCode)) &&
        getAfter(/databases/$(database)/documents/share_codes/$(after.shareCode)).data.babyId == babyId;
    }

    function isVerifiedInvitation(code, babyId, members) {
      let invitation = get(/databases/$(database)/documents/share_codes/$(code)).data;
      return invitation.keys().hasAll(['issuedBy', 'issuerEmail']) &&
        invitation.babyId == babyId && invitation.issuedBy in members &&
        get(/databases/$(database)/documents/verified_emails/$(invitation.issuedBy)).data.email == invitation.issuerEmail;
    }

    // Only the server can record proof or attach an issuer to an invitation.
    match /verified_emails/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
    }

    match /babies/{babyId} {
      allow create: if isSignedIn() && isValidBabyCreate();
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow update: if isRoutineBabyUpdate(babyId) || isLeavingBaby(babyId) || isJoiningBaby(babyId);
      allow delete: if isSignedIn() &&
        request.auth.uid in resource.data.memberUids &&
        resource.data.memberUids.size() == 1;

      match /entries/{entryId} {
        allow read, delete: if isBabyMember(babyId);
        allow create: if isBabyMember(babyId) &&
          request.resource.data.babyId == babyId &&
          request.resource.data.loggedBy == request.auth.uid;
        allow update: if isBabyMember(babyId) &&
          request.resource.data.babyId == resource.data.babyId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          (!resource.data.keys().hasAny(['achievementDay']) ||
            request.resource.data.achievementDay == resource.data.achievementDay) &&
          request.resource.data.loggedBy == request.auth.uid;
      }

      match /achievement_celebrations/{awardId} {
        allow read, delete: if isBabyMember(babyId);
        allow create: if isBabyMember(babyId) &&
          request.resource.data.keys().hasOnly(['days', 'loggedBy', 'createdAt']) &&
          request.resource.data.days in [7, 14, 30] &&
          request.resource.data.loggedBy == request.auth.uid &&
          request.resource.data.createdAt == request.time;
      }
    }

    match /share_codes/{code} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['babyId']) &&
        request.resource.data.babyId is string &&
        request.auth.uid in babyAfter(request.resource.data.babyId).data.memberUids;
      allow delete: if isSignedIn() &&
        (isJoiningBaby(resource.data.babyId) ||
         (!existsAfter(/databases/$(database)/documents/babies/$(resource.data.babyId)) &&
          isBabyMember(resource.data.babyId)));
    }

    match /caregiver_profiles/{uid} {
      allow read, create, update: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
