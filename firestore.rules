rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null &&
        !exists(/databases/$(database)/documents/deletion_blocks/$(request.auth.uid));
    }

    function babyBefore(babyId) {
      return get(/databases/$(database)/documents/babies/$(babyId));
    }

    function isBabyMember(babyId) {
      return isSignedIn() &&
        request.auth.uid in babyBefore(babyId).data.memberUids &&
        babyBefore(babyId).data.get('diaryDeletionRequested', false) == false;
    }

    function hasConsent(data) {
      return data.get('consentVersion', 0) == 1;
    }

    function canUseDiary(babyId) {
      return isBabyMember(babyId) && hasConsent(babyBefore(babyId).data);
    }

    function validConsent(data) {
      return data.consentVersion == 1 && data.consentBy == request.auth.uid &&
        data.consentAt == request.time;
    }

    function isConsentUpdate() {
      return isSignedIn() && request.auth.uid in resource.data.memberUids &&
        (request.auth.uid == resource.data.ownerUid ||
         !(resource.data.ownerUid in resource.data.memberUids)) &&
        resource.data.get('consentVersion', 0) == 0 &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['consentVersion', 'consentBy', 'consentAt']) &&
        validConsent(request.resource.data);
    }

    function validName(value) {
      return value is string && value.size() > 0 && value.size() <= 120;
    }

    function optionalText(data, field, limit) {
      return !(field in data) || (data[field] is string && data[field].size() <= limit);
    }

    function validOwnDetails(data) {
      return data.memberLabels is map && data.get('memberEmails', {}) is map &&
        optionalText(data.memberLabels, request.auth.uid, 120) &&
        optionalText(data.get('memberEmails', {}), request.auth.uid, 320);
    }

    function validEntry(data) {
      return data.keys().hasOnly(['babyId', 'timestamp', 'achievementDay',
          'consistency', 'size', 'color', 'notes', 'loggedBy', 'loggedByName',
          'loggedByEmail', 'createdAt']) &&
        data.timestamp is timestamp && data.createdAt is timestamp &&
        data.timestamp >= timestamp.date(2020, 1, 1) &&
        data.timestamp <= request.time + duration.value(5, 'm') &&
        data.consistency in ['hard', 'formed', 'pasty', 'soft', 'watery', 'unusual'] &&
        (!('size' in data) || data.size in ['small', 'medium', 'large']) &&
        (!('color' in data) || data.color in ['yellow', 'brown', 'green', 'orange',
          'red', 'pale_white', 'black', 'mustard_yellow', 'darker_yellow',
          'green_black', 'frothy_green', 'dark_green', 'green_brown', 'chalk_white']) &&
        optionalText(data, 'notes', 10000) &&
        optionalText(data, 'loggedByName', 120) &&
        optionalText(data, 'loggedByEmail', 320) &&
        (!('achievementDay' in data) || (data.achievementDay is string &&
          data.achievementDay.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')));
    }

    function isValidBabyCreate() {
      return request.resource.data.keys().hasOnly([
          'name', 'ownerUid', 'memberUids', 'memberLabels', 'memberEmails', 'shareCode', 'createdAt', 'consentVersion', 'consentBy', 'consentAt'
        ]) &&
        validConsent(request.resource.data) &&
        validName(request.resource.data.name) &&
        request.resource.data.createdAt is timestamp &&
        validOwnDetails(request.resource.data) &&
        request.resource.data.memberUids is list &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.memberUids.size() == 1 &&
        request.resource.data.memberUids[0] == request.auth.uid &&
        request.resource.data.memberLabels.keys().hasOnly([request.auth.uid]) &&
        request.resource.data.memberEmails.keys().hasOnly([request.auth.uid]) &&
        request.resource.data.shareCode is string &&
        request.resource.data.shareCode.size() == 0;
    }

    function isRoutineBabyUpdate() {
      return isSignedIn() && request.auth.uid in resource.data.memberUids &&
        validName(request.resource.data.name) && validOwnDetails(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'memberLabels', 'memberEmails'
        ]) &&
        request.resource.data.memberUids == resource.data.memberUids &&
        request.resource.data.memberLabels.diff(resource.data.memberLabels)
          .affectedKeys().hasOnly([request.auth.uid]) &&
        (
          (!resource.data.keys().hasAny(['memberEmails']) &&
            request.resource.data.memberEmails.keys().hasOnly([request.auth.uid])) ||
          (resource.data.keys().hasAny(['memberEmails']) &&
            request.resource.data.memberEmails.diff(resource.data.memberEmails)
              .affectedKeys().hasOnly([request.auth.uid])
          )
        );
    }

    function isLeavingBaby() {
      return isSignedIn() && request.auth.uid in resource.data.memberUids &&
        resource.data.memberUids.size() > 1 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberUids', 'memberLabels', 'memberEmails'
        ]) &&
        request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1 &&
        request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().difference([request.auth.uid].toSet()) &&
        !request.resource.data.memberUids.hasAny([request.auth.uid]) &&
        !request.resource.data.memberLabels.keys().hasAny([request.auth.uid]) &&
        request.resource.data.memberLabels.diff(resource.data.memberLabels)
          .affectedKeys().hasOnly([request.auth.uid]) &&
        !request.resource.data.get('memberEmails', {}).keys().hasAny([request.auth.uid]) &&
        request.resource.data.get('memberEmails', {}).diff(resource.data.get('memberEmails', {}))
          .affectedKeys().hasOnly([request.auth.uid]);
    }

    // Only the server can record proof or attach an issuer to an invitation.
    match /verified_emails/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
    }

    match /babies/{babyId} {
      allow create: if isSignedIn() && isValidBabyCreate();
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow update: if resource.data.get('diaryDeletionRequested', false) == false &&
        (isConsentUpdate() || isRoutineBabyUpdate() || isLeavingBaby());
      // Whole-diary deletion is server-only: verified membership, then retryable cleanup.

      match /entries/{entryId} {
        allow read: if canUseDiary(babyId);
        allow delete: if isBabyMember(babyId);
        allow create: if canUseDiary(babyId) && validEntry(request.resource.data) &&
          request.resource.data.babyId == babyId &&
          request.resource.data.loggedBy == request.auth.uid;
        allow update: if canUseDiary(babyId) && validEntry(request.resource.data) &&
          request.resource.data.babyId == resource.data.babyId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          (!resource.data.keys().hasAny(['achievementDay']) ||
            request.resource.data.achievementDay == resource.data.achievementDay) &&
          request.resource.data.loggedBy == request.auth.uid;
      }

      match /achievement_celebrations/{awardId} {
        allow read: if canUseDiary(babyId);
        allow delete: if isBabyMember(babyId);
        allow create: if canUseDiary(babyId) &&
          request.resource.data.keys().hasOnly(['days', 'loggedBy', 'createdAt']) &&
          request.resource.data.days in [7, 14, 30] &&
          request.resource.data.loggedBy == request.auth.uid &&
          request.resource.data.createdAt == request.time;
      }
    }

    // Invitation lookup and consumption are server-only, with rate limits.
    match /share_codes/{code} {
      allow read, write: if false;
    }

    match /caregiver_profiles/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['name', 'email']) &&
        validName(request.resource.data.name) &&
        request.resource.data.email is string && request.resource.data.email.size() <= 320;
    }
  }
}
